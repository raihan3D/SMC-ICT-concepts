showKillzonesInput              = input.bool(true, 'Show Killzone Backgrounds', group = ICT_GROUP)
asianSessionInput               = input.session('2000-0000', 'Asian Session (EST)', group = ICT_GROUP)
asianColorInput                 = input.color(color.new(#2157f3, 90), 'Asian Color', group = ICT_GROUP)
